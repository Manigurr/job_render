{% set flash_url = node.artifacts.flash_image %}
{% set flash_path = flash_url.split('?')[0] %}
{% set flash_name = flash_path.split('/')[-1] %}

- deploy:
    images:
      flash_files:
        url: '{{ node.artifacts.flash_image }}'

    postprocess:
      docker:
        image: ghcr.io/mwasilew/docker-mkbootimage:master
        steps:
        - 'set -e'

        - 'export IMAGE_PATH=$PWD'

        - 'echo "DEBUG: platform={{ platform_config.name }}"'
        - 'echo "DEBUG: flash image={{ flash_name }}"'

        - 'echo "=== Downloaded files ==="'
        - 'ls -lh "$IMAGE_PATH"'

        - 'echo "=== Extracting complete qcomflash package ==="'
        - 'mkdir -p flash_content'
        - 'tar -xf "{{ flash_name }}" -C flash_content'
        - 'rm -f "{{ flash_name }}"'

        - 'echo "=== Complete qcomflash contents ==="'
        - 'find flash_content -maxdepth 3 -type f -print | sort'

        - 'test -f flash_content/rootfs.img'
        - 'echo "Confirmed rootfs.img exists inside complete qcomflash package"'

        - 'echo "=== Locating LAVA overlay ==="'
        - 'overlay_file="$(find "$IMAGE_PATH" -maxdepth 1 -type f -name "overlay*.tar.gz" ! -name "overlay.tar.gz" -print -quit)"'
        - 'test -n "$overlay_file"'
        - 'echo "Selected overlay: $overlay_file"'

        - 'echo "=== LAVA overlay contents ==="'
        - 'tar -tzf "$overlay_file" | head -100'

        - 'echo "=== Mounting rootfs.img ==="'
        - 'mkdir -p rootfs_mount'
        - 'mount -o loop,rw flash_content/rootfs.img rootfs_mount'

        - 'cleanup_rootfs() { umount rootfs_mount 2>/dev/null || true; rm -rf rootfs_mount; }'
        - 'trap cleanup_rootfs EXIT'

        - 'echo "=== Injecting LAVA overlay into rootfs.img ==="'
        - 'tar -xzf "$overlay_file" -C rootfs_mount'

        - 'sync'

        - 'echo "=== Validating LAVA environment file ==="'
        - 'lava_environment="$(find rootfs_mount -type f -path "*/environment" -print -quit)"'
        - 'test -n "$lava_environment"'
        - 'echo "Confirmed LAVA environment file: $lava_environment"'

        - 'echo "=== Validating rootfs contents ==="'
        - 'find rootfs_mount -maxdepth 2 -type d -name "lava-*" -print'
        - 'ls -lh flash_content/rootfs.img'

        - 'echo "=== Unmounting rootfs.img ==="'
        - 'umount rootfs_mount'
        - 'rm -rf rootfs_mount'
        - 'trap - EXIT'

        - 'echo "=== Creating flash.settings ==="'
        - 'rm -f "$IMAGE_PATH/flash.settings"'
        - 'echo "DEVICE_TYPE={{ platform_config.name }}" >> "$IMAGE_PATH/flash.settings"'
        - 'echo "PORT=0" >> "$IMAGE_PATH/flash.settings"'

        - 'echo "=== flash.settings ==="'
        - 'cat "$IMAGE_PATH/flash.settings"'

        - 'echo "=== Creating combined flash archive ==="'
        - 'tar -cf "$IMAGE_PATH/combined_flash.tar" -C flash_content .'

        - 'test -f "$IMAGE_PATH/combined_flash.tar"'
        - 'ls -lh "$IMAGE_PATH/combined_flash.tar"'

        - 'rm -rf flash_content'

    timeout:
      minutes: 120

    to: downloads


- deploy:
    images:
      image:
        url: downloads://combined_flash.tar

      settings:
        url: downloads://flash.settings

    timeout:
      minutes: 10

    to: flasher


- boot:
    auto_login:
      login_prompt: '(.*)login:'
      username: root
      password_prompt: Password
      password: oelinux123

    prompts:
      - 'root@(.*):[/~]#'

    failure_retry: 3

    timeout:
      minutes: 20

    timeouts:
      bootloader-commands:
        minutes: 5

      auto-login-action:
        minutes: 20

    method: minimal
