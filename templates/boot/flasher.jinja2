- deploy:
    images:
      flash_files:
        url: '{{ node.artifacts.flash_image }}'
{% if node.artifacts.rootfs_image %}
      rootfs_img:
        url: '{{ node.artifacts.rootfs_image }}'
{% endif %}
    postprocess:
      docker:
        image: ghcr.io/mwasilew/docker-mkbootimage:master
        steps:
{% set flash_url = node.artifacts.flash_image %}
{% set flash_path = flash_url.split('?')[0] %}
{% set flash_name = flash_path.split('/')[-1] %}
        - export IMAGE_PATH=$PWD
        - mkdir -p flash_content
        - tar -xf {{ flash_name }} -C flash_content
        - rm {{ flash_name }}
{% if node.artifacts.rootfs_image %}
{% set rootfs_url = node.artifacts.rootfs_image %}
{% set rootfs_path = rootfs_url.split('?')[0] %}
{% set rootfs_name = rootfs_path.split('/')[-1] %}
        - mv {{ rootfs_name }} flash_content/rootfs.img
{% endif %}
        - cp overlay*.tar.gz overlay.tar.gz
        - echo "=== Overlay inspection ==="
        - tar -tzf overlay.tar.gz | head -20
        - echo "=== /etc/passwd in overlay ===" && tar -xOf overlay.tar.gz etc/passwd 2>/dev/null || echo "No etc/passwd found in overlay"
        - echo "=== /etc/shadow in overlay ===" && tar -xOf overlay.tar.gz etc/shadow 2>/dev/null || echo "No etc/shadow found in overlay"
        - echo "=== Baking overlay into rootfs using debugfs ==="
        - mkdir -p /tmp/lava_overlay
        - tar -xzf overlay.tar.gz -C /tmp/lava_overlay
        - |
          python3 -c "
          import os
          base = '/tmp/lava_overlay'
          lines = []
          for root, dirs, files in os.walk(base):
              relroot = os.path.relpath(root, base)
              if relroot != '.':
                  lines.append('mkdir /' + relroot.replace(os.sep, '/'))
              for f in files:
                  src = os.path.join(root, f)
                  dst = relroot + '/' + f if relroot != '.' else f
                  dst = '/' + dst.replace(os.sep, '/')
                  lines.append('write ' + src + ' ' + dst)
          print('\n'.join(lines))
          " > /tmp/debugfs_cmds.txt
        - echo "=== debugfs commands preview (first 20) ==="
        - head -20 /tmp/debugfs_cmds.txt
        - debugfs -w flash_content/rootfs.img < /tmp/debugfs_cmds.txt
        - echo "=== Verifying overlay baked into rootfs ==="
        - echo "ls /lava-${LAVA_JOB_ID}" | debugfs flash_content/rootfs.img 2>/dev/null || echo "Verification check done"
        - echo "DEVICE_TYPE={{ platform_config.name }}" >> $IMAGE_PATH/flash.settings
        - echo "PORT=0" >> $IMAGE_PATH/flash.settings
        - cat $IMAGE_PATH/flash.settings
        - tar -cf combined_flash.tar -C flash_content .
        - rm -rf flash_content
    timeout:
      minutes: 120
    to: downloads

- deploy:
    images:
      image:
        url: 'downloads://combined_flash.tar'
      settings:
        url: downloads://flash.settings
    timeout:
      minutes: 10
    to: flasher

- boot:
    auto_login:
      login_prompt: '(.*)login:'
      username: root
      password_prompt: Password
      password: oelinux123
    prompts:
    - root@(.*):[/~]#
    failure_retry: 3
    timeout:
      minutes: 20
    timeouts:
      bootloader-commands:
        minutes: 5
      auto-login-action:
        minutes: 20
    method: minimal