{% set flash_url = node.artifacts.flash_image %}
{% set flash_path = flash_url.split('?')[0] %}
{% set flash_name = flash_path.split('/')[-1] %}

- deploy:
    images:
      flash_files:
        url: '{{ node.artifacts.flash_image }}'

    postprocess:
      docker:
        image: ghcr.io/mwasilew/docker-mkbootimage:master
        steps:
        - 'set -e'
        - 'export IMAGE_PATH=$PWD'
        - 'echo "DEBUG: platform={{ platform_config.name }}"'
        - 'echo "DEBUG: flash image={{ flash_name }}"'
        - 'echo "=== Downloaded files ==="'
        - 'ls -lh "$IMAGE_PATH"'
        - 'mkdir -p flash_content'
        - 'tar -xf "{{ flash_name }}" -C flash_content'
        - 'rm -f "{{ flash_name }}"'
        - 'echo "=== Complete qcomflash contents ==="'
        - 'find flash_content -maxdepth 2 -type f -print | sort'
        - 'test -f flash_content/rootfs.img'
        - 'echo "Confirmed rootfs.img exists inside complete flash package"'
        - 'overlay_file="$(find "$IMAGE_PATH" -maxdepth 1 -type f -name "overlay*.tar.gz" ! -name "overlay.tar.gz" -print -quit)"'
        - 'test -n "$overlay_file"'
        - 'cp "$overlay_file" "$IMAGE_PATH/overlay.tar.gz"'
        - 'echo "Selected overlay: $overlay_file"'
        - 'echo "=== Injecting LAVA overlay into rootfs.img ==="'
        - 'mkdir -p /mnt/rootfs_inject'
        - 'mount -o loop flash_content/rootfs.img /mnt/rootfs_inject || echo "WARNING: mount failed, overlay injection skipped"'
        - 'if mountpoint -q /mnt/rootfs_inject; then tar -xzf "$IMAGE_PATH/overlay.tar.gz" -C /mnt/rootfs_inject/ || true; sync; umount /mnt/rootfs_inject; echo "LAVA overlay injected into rootfs.img"; else echo "WARNING: rootfs not mounted, LAVA overlay NOT injected"; fi'
        - 'rmdir /mnt/rootfs_inject || true'
        - 'echo "OVERLAY=overlay.tar.gz" >> "$IMAGE_PATH/flash.settings"'
        - 'echo "OVERLAY_PATH=/" >> "$IMAGE_PATH/flash.settings"'
        - 'echo "DEVICE_TYPE={{ platform_config.name }}" >> "$IMAGE_PATH/flash.settings"'
        - 'echo "PORT=0" >> "$IMAGE_PATH/flash.settings"'
        - 'echo "=== flash.settings ==="'
        - 'cat "$IMAGE_PATH/flash.settings"'
        - 'tar -cf "$IMAGE_PATH/combined_flash.tar" -C flash_content .'
        - 'test -f "$IMAGE_PATH/combined_flash.tar"'
        - 'ls -lh "$IMAGE_PATH/combined_flash.tar"'
        - 'rm -rf flash_content'

    timeout:
      minutes: 120
    to: downloads

- deploy:
    images:
      image:
        url: downloads://combined_flash.tar
      settings:
        url: downloads://flash.settings
      overlay:
        url: downloads://overlay.tar.gz
    timeout:
      minutes: 10
    to: flasher

- boot:
    auto_login:
      login_prompt: '(.*)login:'
      username: root
      password_prompt: Password
      password: oelinux123

    prompts:
      - 'root@(.*):[/~]#'

    failure_retry: 3

    timeout:
      minutes: 20

    timeouts:
      bootloader-commands:
        minutes: 5
      auto-login-action:
        minutes: 20

    method: minimal
