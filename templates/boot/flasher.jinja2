- deploy:
    images:
      image:
        url: '{{ node.artifacts.flash_image }}'
      test:
        headers:
          Authorization: LAVA_BASIC_AUTH
        url: 'https://storage-lava-hyd.qualcomm.com/Test_binaries.tar.gz'
      repo:
        url: 'https://github.com/Manigurr/qcom-linux-testkit/archive/refs/heads/video-test-suite-import.zip'

    postprocess:
      docker:
        image: ghcr.io/mwasilew/docker-mkbootimage:master
        steps:
          - |
            set -e

            IMAGE_PATH="$PWD"
            export IMAGE_PATH

            echo "========================================"
            echo "Starting overlay customization"
            echo "========================================"

            # --- Step 1: Extract base overlay ---
            cp overlay*.tar.gz overlay.tar.gz
            mkdir -p overlay_root
            tar -xzf overlay.tar.gz -C overlay_root
            rm -f overlay.tar.gz

            # --- Step 2: Extract Test_binaries into overlay ---
            if [ -f Test_binaries.tar.gz ]; then
              tar -xzf Test_binaries.tar.gz -C overlay_root
              rm -f Test_binaries.tar.gz
            else
              echo "ERROR: Test_binaries.tar.gz not found"
              exit 1
            fi

            # --- Step 3: Verify zip was downloaded by LAVA ---
            if [ ! -f video-test-suite-import.zip ]; then
              echo "ERROR: video-test-suite-import.zip was not found"
              ls -la
              exit 1
            fi

            # --- Step 4: Verify ADB availability ---
            echo ""
            echo "========================================"
            echo "ADB VALIDATION"
            echo "========================================"

            if command -v adb >/dev/null 2>&1; then
              echo "[PASS] adb binary found"

              echo "ADB Location:"
              which adb

              echo ""
              echo "ADB Version:"
              adb version || true

              echo ""
              echo "ADB Devices:"
              adb devices || true
            else
              echo "[WARNING] adb binary not found in container"
            fi

            echo "========================================"
            echo ""

            # --- Step 5: Copy video test suite zip directly ---
            mkdir -p overlay_root/opt/qcom-linux-testkit

            cp video-test-suite-import.zip \
              overlay_root/opt/qcom-linux-testkit/

            ls -lh overlay_root/opt/qcom-linux-testkit/

            rm -f video-test-suite-import.zip

            # --- Step 6: Repack final overlay ---
            tar -czf overlay.tar.gz -C overlay_root .
            rm -rf overlay_root

            ls -lh overlay.tar.gz

            # --- Step 7: Generate flash.settings ---
            cat > "$IMAGE_PATH/flash.settings" <<EOF
            OVERLAY=overlay.tar.gz
            OVERLAY_PATH=/
            ROOTFS_IMAGE=rootfs.img
            DEVICE_TYPE={{ platform_config.name }}
            PORT=0
            EOF

            echo ""
            echo "Generated flash.settings:"
            cat "$IMAGE_PATH/flash.settings"

            echo ""
            echo "Overlay customization completed successfully"

    timeout:
      minutes: 40
    to: downloads

{% set flash_image_url = node.artifacts.flash_image %}
{% set flash_image_path = flash_image_url.split('?')[0] %}
{% set flash_image_name = flash_image_path.split('/')[-1] %}

- deploy:
    images:
      image:
        url: 'downloads://{{ flash_image_name }}'
      settings:
        url: downloads://flash.settings
      overlay:
        url: downloads://overlay.tar.gz
    timeout:
      minutes: 20
    to: flasher

- boot:
    auto_login:
      login_prompt: 'login:'
      username: root
      password_prompt: Password
      password: oelinux123
    prompts:
      - 'root@{{ platform_config.name }}'
      - 'root@(.*):[/~]#'
    failure_retry: 3
    timeout:
      minutes: 10
    timeouts:
      bootloader-commands:
        minutes: 3
      auto-login-action:
        minutes: 10
    method: minimal
