- deploy:
    images:
      flash_files:
        url: '{{ node.artifacts.flash_image }}'
{% if node.artifacts.rootfs_image %}
      rootfs_img:
        url: '{{ node.artifacts.rootfs_image }}'
{% endif %}
    postprocess:
      docker:
        image: ghcr.io/mwasilew/docker-mkbootimage:master
        steps:
{% set flash_url = node.artifacts.flash_image %}
{% set flash_path = flash_url.split('?')[0] %}
{% set flash_name = flash_path.split('/')[-1] %}
        - export IMAGE_PATH=$PWD
        - mkdir -p flash_content
        - tar -xf {{ flash_name }} -C flash_content
        - rm {{ flash_name }}
{% if node.artifacts.rootfs_image %}
{% set rootfs_url = node.artifacts.rootfs_image %}
{% set rootfs_path = rootfs_url.split('?')[0] %}
{% set rootfs_name = rootfs_path.split('/')[-1] %}
        - mv {{ rootfs_name }} flash_content/rootfs.img
{% endif %}
        - echo "=== rootfs.img size ==="
        - ls -lh flash_content/rootfs.img
        - |
          MAGIC=$(od -A n -t x1 -N 4 flash_content/rootfs.img | tr -d ' \n')
          echo "=== rootfs.img magic bytes: $MAGIC ==="
          if [ "$MAGIC" = "3aff26ed" ]; then
            echo "=== Detected sparse image, converting to raw ext4 ==="
            simg2img flash_content/rootfs.img flash_content/rootfs_raw.img
            mv flash_content/rootfs_raw.img flash_content/rootfs.img
            echo "=== Conversion done ==="
            ls -lh flash_content/rootfs.img
          else
            echo "=== rootfs.img is already raw ext4 ==="
          fi
        - echo "=== Running fsck on rootfs before overlay baking ==="
        - e2fsck -fy flash_content/rootfs.img || echo "WARN: fsck reported issues (exit code $?)"
        - echo "=== Checking rootfs filesystem info ==="
        - dumpe2fs flash_content/rootfs.img 2>/dev/null | grep -E "Free (blocks|inodes)|Block count|Inode count" || echo "Could not get fs info"
        - cp overlay*.tar.gz overlay.tar.gz
        - echo "=== Overlay inspection ==="
        - tar -tzf overlay.tar.gz | head -20
        - echo "=== /etc/passwd in overlay ===" && tar -xOf overlay.tar.gz etc/passwd 2>/dev/null || echo "No etc/passwd found in overlay"
        - echo "=== /etc/shadow in overlay ===" && tar -xOf overlay.tar.gz etc/shadow 2>/dev/null || echo "No etc/shadow found in overlay"
        - echo "=== Baking overlay into rootfs using e2tools ==="
        - mkdir -p /tmp/lava_overlay
        - tar -xzf overlay.tar.gz -C /tmp/lava_overlay
        - |
          set -e
          if ! command -v e2cp > /dev/null 2>&1; then
            echo "e2tools not found, attempting apt install..."
            apt-get update -qq && apt-get install -y -qq e2tools || {
              echo "FATAL: e2tools not available"
              exit 1
            }
          fi
          echo "=== e2tools available ==="
          ROOTFS=flash_content/rootfs.img
          BASE=/tmp/lava_overlay
          
          echo "=== Creating directories in rootfs ==="
          find $BASE -type d | sort | while read dir; do
            reldir=$(echo "$dir" | sed "s|$BASE||")
            if [ -n "$reldir" ]; then
              echo "Creating dir: $reldir"
              if ! e2mkdir -p "${ROOTFS}:${reldir}"; then
                echo "ERROR: e2mkdir failed for $reldir"
                # Try to check if parent exists
                parent=$(dirname "$reldir")
                e2ls "${ROOTFS}:${parent}" 2>&1 || echo "Parent $parent does not exist"
                exit 1
              fi
              # Verify directory was created
              if ! e2ls "${ROOTFS}:${reldir}" >/dev/null 2>&1; then
                echo "FATAL: Directory $reldir not found after creation"
                exit 1
              fi
            fi
          done
          
          echo "=== Copying files to rootfs ==="
          find $BASE -type f | while read src; do
            reldst=$(echo "$src" | sed "s|$BASE||")
            echo "Copying: $reldst ($(stat -c%s "$src") bytes)"
            
            # Ensure parent directory exists
            parent=$(dirname "$reldst")
            if [ "$parent" != "/" ] && [ "$parent" != "." ]; then
              e2ls "${ROOTFS}:${parent}" >/dev/null 2>&1 || {
                echo "ERROR: Parent directory $parent missing before copy"
                exit 1
              }
            fi
            
            # Copy the file
            if ! e2cp -p "$src" "${ROOTFS}:${reldst}"; then
              echo "FATAL: e2cp failed for $reldst"
              echo "Source file: $src"
              echo "Destination: ${ROOTFS}:${reldst}"
              ls -lh "$src"
              exit 1
            fi
            
            # Verify file was copied and has correct size
            if ! e2ls "${ROOTFS}:${reldst}" >/dev/null 2>&1; then
              echo "FATAL: File $reldst not found after copy"
              exit 1
            fi
            
            # Check file size in rootfs (basic verification)
            src_size=$(stat -c%s "$src")
            echo "  -> Copied successfully (source: $src_size bytes)"
          done
          
          echo "=== Overlay bake complete ==="
        - echo "=== Running fsck after overlay baking ==="
        - e2fsck -fy flash_content/rootfs.img || echo "WARN: fsck after baking reported issues (exit code $?)"
        - echo "=== Comprehensive overlay verification in rootfs ==="
        - |
          set -e
          ROOTFS=flash_content/rootfs.img
          LAVA_DIR=$(ls /tmp/lava_overlay/ | grep '^lava-' | head -1)
          
          if [ -z "$LAVA_DIR" ]; then
            echo "FATAL: No lava- directory found in overlay"
            ls -la /tmp/lava_overlay/
            exit 1
          fi
          
          echo "LAVA directory: $LAVA_DIR"
          
          # List contents of LAVA directory in rootfs
          echo "=== Contents of /$LAVA_DIR in rootfs ==="
          e2ls -l "${ROOTFS}:/${LAVA_DIR}/" || {
            echo "FATAL: Cannot list /$LAVA_DIR in rootfs"
            exit 1
          }
          
          # Verify critical files
          echo "=== Verifying critical LAVA files ==="
          for file in environment bin/lava-test-runner bin/lava-test-shell; do
            filepath="/${LAVA_DIR}/${file}"
            echo "Checking: $filepath"
            if ! e2ls "${ROOTFS}:${filepath}" >/dev/null 2>&1; then
              echo "FATAL: Missing critical file: $filepath"
              echo "Contents of $(dirname $filepath):"
              e2ls "${ROOTFS}:$(dirname $filepath)" || echo "Parent directory missing!"
              exit 1
            fi
            echo "  -> OK: $filepath exists"
          done
          
          # Verify environment file specifically
          if ! e2ls "${ROOTFS}:/${LAVA_DIR}/environment" | grep -q "environment"; then
            echo "FATAL: environment file NOT found in rootfs — baking failed!"
            echo "Listing /$LAVA_DIR again:"
            e2ls -la "${ROOTFS}:/${LAVA_DIR}/"
            exit 1
          fi
          
          echo "SUCCESS: All critical LAVA overlay files confirmed in rootfs!"
          echo "SUCCESS: /$LAVA_DIR/environment verified in rootfs!"
        - echo "DEVICE_TYPE={{ platform_config.name }}" >> $IMAGE_PATH/flash.settings
        - echo "PORT=0" >> $IMAGE_PATH/flash.settings
        - cat $IMAGE_PATH/flash.settings
        - tar -cf combined_flash.tar -C flash_content .
        - rm -rf flash_content
    timeout:
      minutes: 120
    to: downloads

- deploy:
    images:
      image:
        url: 'downloads://combined_flash.tar'
      settings:
        url: downloads://flash.settings
    timeout:
      minutes: 10
    to: flasher

- boot:
    auto_login:
      login_prompt: '(.*)login:'
      username: root
      password_prompt: Password
      password: oelinux123
    prompts:
    - root@(.*):[/~]#
    failure_retry: 3
    timeout:
      minutes: 20
    timeouts:
      bootloader-commands:
        minutes: 5
      auto-login-action:
        minutes: 20
    method: minimal
