{% set flash_image_url = node.artifacts.flash_image %}
{% set flash_image_path = flash_image_url.split('?')[0] %}
{% set flash_image_name = flash_image_path.split('/')[-1] %}
- deploy:
    images:
      image:
        url: '{{ node.artifacts.flash_image }}'
      test:
        headers:
          Authorization: LAVA_BASIC_AUTH
        url: 'https://storage-lava-hyd.qualcomm.com/Test_binaries.tar.gz'
    postprocess:
      docker:
        image: ghcr.io/mwasilew/docker-mkbootimage:master
        steps:
        - export IMAGE_PATH=$PWD
        - export IMG={{ flash_image_name }}
        - echo "=== Preparing combined test overlay ==="
        - cp overlay*.tar.gz overlay.tar.gz
        - mkdir overlay_root
        - tar -xzvf overlay.tar.gz -C overlay_root
        - tar -xzvf Test_binaries.tar.gz -C overlay_root
        - echo "=== Installing e2tools if required ==="
        - |
          if ! command -v e2cp > /dev/null 2>&1; then
            apt-get update -qq && apt-get install -y -qq e2tools
          fi
        - echo "=== Extracting $IMG ==="
        - mkdir -p flash_content
        - tar -xf "$IMG" -C flash_content
        - |
          if [ ! -f flash_content/rootfs.img ]; then
            echo "FATAL: rootfs.img not found inside $IMG"
            ls -la flash_content
            exit 1
          fi
        - e2fsck -fy flash_content/rootfs.img || echo "WARN fsck exit code $?"
        - echo "=== Baking overlay into flash_content/rootfs.img ==="
        - |
          set -e
          BASE=overlay_root
          find "$BASE" -type d | sort | while read -r dir; do
            reldir="${dir#$BASE}"
            [ -z "$reldir" ] && continue
            e2mkdir "flash_content/rootfs.img:${reldir}" || { echo "FATAL: e2mkdir failed for $reldir"; exit 1; }
          done
          find "$BASE" -type f | while read -r src; do
            reldst="${src#$BASE}"
            e2cp -p "$src" "flash_content/rootfs.img:${reldst}" || { echo "FATAL: e2cp failed for $reldst"; exit 1; }
          done
        - echo "=== Verifying overlay baked into rootfs.img ==="
        - |
          set -e
          LAVA_DIR=$(ls overlay_root | grep '^lava-' | head -1)
          if [ -z "$LAVA_DIR" ]; then
            echo "FATAL: no lava-<job> directory found in overlay"
            exit 1
          fi
          if ! e2ls "flash_content/rootfs.img:/$LAVA_DIR/environment" > /dev/null 2>&1; then
            echo "FATAL: /$LAVA_DIR/environment missing from rootfs.img after bake"
            e2ls "flash_content/rootfs.img:/$LAVA_DIR/" || true
            exit 1
          fi
          echo "SUCCESS: /$LAVA_DIR/environment confirmed in rootfs.img"
        - e2fsck -fy flash_content/rootfs.img || echo "WARN fsck exit code $?"
        - echo "=== Repacking $IMG with baked rootfs.img ==="
        - rm -f "$IMG"
        - tar -cf "$IMG" -C flash_content .
        - rm -rf flash_content
        - echo "DEVICE_TYPE={{ platform_config.name }}" >> $IMAGE_PATH/flash.settings
        - echo "PORT=0" >> $IMAGE_PATH/flash.settings
        - cat $IMAGE_PATH/flash.settings
    timeout:
     minutes: 45
    to: downloads
- deploy:
    images:
      image:
        url: 'downloads://{{ flash_image_name }}'
      settings:
        url: downloads://flash.settings
    timeout:
       minutes: 20
    to: flasher
- boot:
    auto_login:
      login_prompt: 'login:'
      username: root
      password_prompt: Password
      password: oelinux123
    prompts:
    - root@{{ platform_config.name }}
    - root@(.*):[/~]#
    failure_retry: 3
    timeout:
      minutes: 10
    timeouts:
      bootloader-commands:
        minutes: 3
      auto-login-action:
        minutes: 10
    method: minimal
