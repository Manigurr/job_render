- deploy:
    images:
      flash_files:
        url: '{{ node.artifacts.flash_image }}'
{% if node.artifacts.rootfs_image %}
      rootfs_img:
        url: '{{ node.artifacts.rootfs_image }}'
{% endif %}
    postprocess:
      docker:
        image: ghcr.io/mwasilew/docker-mkbootimage:master
        steps:
{% set flash_url = node.artifacts.flash_image %}
{% set flash_path = flash_url.split('?')[0] %}
{% set flash_name = flash_path.split('/')[-1] %}
        - export IMAGE_PATH=$PWD
        - mkdir -p flash_content
        - tar -xf {{ flash_name }} -C flash_content
        - rm {{ flash_name }}
{% if node.artifacts.rootfs_image %}
{% set rootfs_url = node.artifacts.rootfs_image %}
{% set rootfs_path = rootfs_url.split('?')[0] %}
{% set rootfs_name = rootfs_path.split('/')[-1] %}
        - mv {{ rootfs_name }} flash_content/rootfs.img
{% endif %}
        - cp overlay*.tar.gz overlay.tar.gz
        - echo "=== Overlay Full File List ==="
        - tar -tzf overlay.tar.gz
        - echo "=== /etc/passwd in overlay ===" && tar -xOf overlay.tar.gz etc/passwd 2>/dev/null || echo "No etc/passwd found in overlay"
        - echo "=== /etc/shadow in overlay ===" && tar -xOf overlay.tar.gz etc/shadow 2>/dev/null || echo "No etc/shadow found in overlay"
        - echo "=== /etc/group in overlay ===" && tar -xOf overlay.tar.gz etc/group 2>/dev/null || echo "No etc/group found in overlay"
        - echo "=== /etc/hostname in overlay ===" && tar -xOf overlay.tar.gz etc/hostname 2>/dev/null || echo "No etc/hostname found in overlay"
        - echo "=== Getty/Autologin related files in overlay ===" && tar -tzf overlay.tar.gz | grep -E "getty|autologin|inittab|pam|profile|shadow" || echo "No getty/autologin files found in overlay"
        - echo "=== Systemd overrides in overlay ===" && tar -tzf overlay.tar.gz | grep -i systemd || echo "No systemd files found in overlay"
        - mkdir -p /mnt/rootfs
        - mount -o loop flash_content/rootfs.img /mnt/rootfs
        - tar -xzf overlay.tar.gz -C /mnt/rootfs
        - echo "=== Verifying overlay applied to rootfs ==="
        - ls /mnt/rootfs/lava-*/bin/ || echo "lava bins not found"
        - umount /mnt/rootfs
        - echo "DEVICE_TYPE={{ platform_config.name }}" >> $IMAGE_PATH/flash.settings
        - echo "PORT=0" >> $IMAGE_PATH/flash.settings
        - cat $IMAGE_PATH/flash.settings
        - tar -cf combined_flash.tar -C flash_content .
        - rm -rf flash_content
    timeout:
      minutes: 120
    to: downloads

- deploy:
    images:
      image:
        url: 'downloads://combined_flash.tar'
      settings:
        url: downloads://flash.settings
    timeout:
      minutes: 10
    to: flasher

- boot:
    auto_login:
      login_prompt: '(.*)login:'
      username: root
      password_prompt: Password
      password: oelinux123
    prompts:
    - root@(.*):[/~]#
    failure_retry: 3
    timeout:
      minutes: 20
    timeouts:
      bootloader-commands:
        minutes: 5
      auto-login-action:
        minutes: 20
    method: minimal