- deploy:
    images:
      image:
        url: '{{ node.artifacts.flash_image }}'

      test:
        headers:
          Authorization: LAVA_BASIC_AUTH
        url: 'https://storage-lava-hyd.qualcomm.com/Test_binaries.tar.gz'

      repo:
        url: 'https://github.com/Manigurr/qcom-linux-testkit/archive/refs/heads/video-test-suite-import.zip'

    postprocess:
      docker:
        image: ghcr.io/mwasilew/docker-mkbootimage:master
        steps:
          - |
            set -exu

            IMAGE_PATH="$PWD"
            export IMAGE_PATH

            echo "========================================"
            echo "Starting overlay customization"
            echo "========================================"

            # --------------------------------------------------
            # Extract existing overlay
            # --------------------------------------------------
            cp overlay*.tar.gz overlay.tar.gz

            mkdir -p overlay_root

            tar -xzf overlay.tar.gz -C overlay_root

            rm -f overlay.tar.gz

            # --------------------------------------------------
            # Extract Test Binaries
            # --------------------------------------------------
            if [ -f Test_binaries.tar.gz ]; then
              tar -xzf Test_binaries.tar.gz -C overlay_root
              rm -f Test_binaries.tar.gz
            else
              echo "ERROR: Test_binaries.tar.gz not found"
              exit 1
            fi

            # --------------------------------------------------
            # Verify repo package exists
            # --------------------------------------------------
            if [ ! -f video-test-suite-import.zip ]; then
              echo "ERROR: video-test-suite-import.zip not found"
              ls -la
              exit 1
            fi

            echo ""
            echo "Repository package available:"
            ls -lh video-test-suite-import.zip

            # --------------------------------------------------
            # Install ADB in Container
            # --------------------------------------------------
            echo ""
            echo "========================================"
            echo "ADB INSTALLATION"
            echo "========================================"

            cat /etc/os-release || true

            if command -v apt-get >/dev/null 2>&1; then
              echo "Detected Debian/Ubuntu"

              apt-get update
              apt-get install -y android-sdk-platform-tools

            elif command -v apk >/dev/null 2>&1; then
              echo "Detected Alpine"

              apk add --no-cache android-tools

            elif command -v dnf >/dev/null 2>&1; then
              echo "Detected Fedora/RHEL"

              dnf install -y android-tools

            elif command -v yum >/dev/null 2>&1; then
              echo "Detected CentOS/RHEL"

              yum install -y android-tools

            else
              echo "WARNING: No supported package manager found"
            fi

            echo ""
            echo "========================================"
            echo "ADB VALIDATION"
            echo "========================================"

            which adb || true

            adb version || true

            adb devices || true

            echo "========================================"

            echo ""
            echo "Overlay content size:"
            du -sh overlay_root || true

            # --------------------------------------------------
            # DO NOT COPY REPO ZIP INTO ROOTFS
            # --------------------------------------------------
            # Keeping video-test-suite-import.zip only inside
            # the postprocess container. Copying it into the
            # overlay causes rootfs.img to run out of space.

            # --------------------------------------------------
            # Repack Overlay
            # --------------------------------------------------
            tar -czf overlay.tar.gz -C overlay_root .

            rm -rf overlay_root

            echo ""
            echo "Generated overlay:"
            ls -lh overlay.tar.gz

            # --------------------------------------------------
            # Generate flash.settings
            # --------------------------------------------------
            cat > "$IMAGE_PATH/flash.settings" <<EOF
            OVERLAY=overlay.tar.gz
            OVERLAY_PATH=/
            ROOTFS_IMAGE=rootfs.img
            DEVICE_TYPE={{ platform_config.name }}
            PORT=0
            EOF

            echo ""
            echo "Generated flash.settings:"
            cat "$IMAGE_PATH/flash.settings"

            echo ""
            echo "Overlay customization completed successfully"

    timeout:
      minutes: 40

    to: downloads

{% set flash_image_url = node.artifacts.flash_image %}
{% set flash_image_path = flash_image_url.split('?')[0] %}
{% set flash_image_name = flash_image_path.split('/')[-1] %}

- deploy:
    images:
      image:
        url: 'downloads://{{ flash_image_name }}'

      settings:
        url: downloads://flash.settings

      overlay:
        url: downloads://overlay.tar.gz

    timeout:
      minutes: 20

    to: flasher

- boot:
    auto_login:
      login_prompt: 'login:'
      username: root
      password_prompt: Password
      password: oelinux123

    prompts:
      - 'root@{{ platform_config.name }}'
      - 'root@(.*):[/~]#'

    failure_retry: 3

    timeout:
      minutes: 10

    timeouts:
      bootloader-commands:
        minutes: 3
      auto-login-action:
        minutes: 10

    method: minimal