{% set flash_url = node.artifacts.flash_image %}
{% set flash_path = flash_url.split('?')[0] %}
{% set flash_name = flash_path.split('/')[-1] %}

- deploy:
    images:
      flash_files:
        url: '{{ node.artifacts.flash_image }}'

    postprocess:
      docker:
        image: ghcr.io/mwasilew/docker-mkbootimage:master
        steps:
        - 'set -e'

        - 'export IMAGE_PATH=$PWD'

        - 'echo "DEBUG: platform={{ platform_config.name }}"'
        - 'echo "DEBUG: flash image={{ flash_name }}"'

        - 'echo "=== Downloaded files ==="'
        - 'ls -lh "$IMAGE_PATH"'

        - 'echo "=== Extracting complete qcomflash package ==="'
        - 'mkdir -p flash_content'
        - 'tar -xf "{{ flash_name }}" -C flash_content'
        - 'rm -f "{{ flash_name }}"'

        - 'echo "=== Complete qcomflash contents ==="'
        - 'find flash_content -maxdepth 3 -type f -print | sort'

        - 'echo "=== Validating rootfs.img ==="'
        - 'test -f flash_content/rootfs.img'
        - 'echo "Confirmed rootfs.img exists inside complete qcomflash package"'
        - 'ls -lh flash_content/rootfs.img'

        - 'echo "=== Locating LAVA overlay ==="'
        - 'overlay_file="$(find "$IMAGE_PATH" -maxdepth 1 -type f -name "overlay*.tar.gz" -print -quit)"'
        - 'test -n "$overlay_file"'
        - 'echo "Selected overlay: $overlay_file"'

        - 'echo "=== LAVA overlay contents ==="'
        - 'tar -tzf "$overlay_file" | head -50'

        - 'echo "=== Extracting LAVA overlay to temp directory ==="'
        - 'mkdir -p overlay_extracted'
        - 'tar -xzf "$overlay_file" -C overlay_extracted'
        - 'echo "Overlay extracted:"'
        - 'find overlay_extracted -maxdepth 3 | sort | head -30'

        - 'echo "=== Checking debugfs availability ==="'
        - 'debugfs -V 2>&1 | head -2 || true'
        - 'which debugfs'

        - 'echo "=== Checking rootfs.img filesystem type ==="'
        - 'file flash_content/rootfs.img'

        - |
          echo "=== Injecting LAVA overlay into rootfs.img using debugfs ==="
          ROOTFS="flash_content/rootfs.img"
          OVERLAY_DIR="overlay_extracted"

          # Build a debugfs command script to create dirs and write files
          DEBUGFS_CMDS=$(mktemp)

          # First pass: create all directories
          find "$OVERLAY_DIR" -mindepth 1 -type d | sort | while read -r dir; do
            rel="/${dir#$OVERLAY_DIR/}"
            echo "mkdir $rel" >> "$DEBUGFS_CMDS"
          done

          # Second pass: write all files
          find "$OVERLAY_DIR" -type f | sort | while read -r file; do
            rel="/${file#$OVERLAY_DIR/}"
            dir_rel="$(dirname $rel)"
            echo "write $file $rel" >> "$DEBUGFS_CMDS"
          done

          echo "=== debugfs command script ==="
          cat "$DEBUGFS_CMDS"

          echo "=== Running debugfs write ==="
          debugfs -w "$ROOTFS" < "$DEBUGFS_CMDS"

          rm -f "$DEBUGFS_CMDS"
          echo "debugfs injection complete"

        - 'echo "=== Setting file permissions in rootfs.img ==="'
        - |
          ROOTFS="flash_content/rootfs.img"
          OVERLAY_DIR="overlay_extracted"

          find "$OVERLAY_DIR" -type f | sort | while read -r file; do
            rel="/${file#$OVERLAY_DIR/}"
            # Make all lava bin/* files executable
            case "$rel" in
              */lava-*/bin/*)
                debugfs -w "$ROOTFS" -R "set_inode_field $rel mode 0100755" 2>/dev/null || true
                ;;
            esac
          done
          echo "Permissions set"

        - 'echo "=== Validating LAVA overlay inside rootfs.img ==="'
        - |
          ROOTFS="flash_content/rootfs.img"
          # Find the lava job dir name from extracted overlay
          LAVA_DIR="$(ls overlay_extracted/ | grep lava- | head -1)"
          echo "Looking for: /$LAVA_DIR/environment"
          RESULT="$(debugfs "$ROOTFS" -R "stat /$LAVA_DIR/environment" 2>&1 || true)"
          echo "$RESULT"
          if echo "$RESULT" | grep -q "Inode:"; then
            echo "Confirmed: /$LAVA_DIR/environment exists in rootfs.img"
          else
            echo "ERROR: /$LAVA_DIR/environment NOT found in rootfs.img"
            exit 1
          fi

        - 'echo "=== Cleaning overlay temp directory ==="'
        - 'rm -rf overlay_extracted'

        - 'echo "=== Creating flash.settings ==="'
        - 'rm -f "$IMAGE_PATH/flash.settings"'
        - 'echo "DEVICE_TYPE={{ platform_config.name }}" >> "$IMAGE_PATH/flash.settings"'
        - 'echo "PORT=0" >> "$IMAGE_PATH/flash.settings"'

        - 'echo "=== flash.settings ==="'
        - 'cat "$IMAGE_PATH/flash.settings"'

        - 'echo "=== Creating combined flash archive ==="'
        - 'tar -cf "$IMAGE_PATH/combined_flash.tar" -C flash_content .'

        - 'echo "=== Validating combined flash archive ==="'
        - 'test -f "$IMAGE_PATH/combined_flash.tar"'
        - 'tar -tf "$IMAGE_PATH/combined_flash.tar" | grep -E "rootfs.img"'
        - 'ls -lh "$IMAGE_PATH/combined_flash.tar"'

        - 'echo "=== Cleaning extracted qcomflash package ==="'
        - 'rm -rf flash_content'

    timeout:
      minutes: 120

    to: downloads


- deploy:
    images:
      image:
        url: downloads://combined_flash.tar

      settings:
        url: downloads://flash.settings

    timeout:
      minutes: 10

    to: flasher


- boot:
    auto_login:
      login_prompt: '(.*)login:'
      username: root
      password_prompt: Password
      password: oelinux123

    prompts:
      - 'root@(.*):[/~]#'

    failure_retry: 3

    timeout:
      minutes: 20

    timeouts:
      bootloader-commands:
        minutes: 5

      auto-login-action:
        minutes: 20

    method: minimal
