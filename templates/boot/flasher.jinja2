- deploy:
    images:
      flash_files:
        url: '{{ node.artifacts.flash_image }}'
{% if node.artifacts.rootfs_image %}
      rootfs_img:
        url: '{{ node.artifacts.rootfs_image }}'
{% endif %}
    postprocess:
      docker:
        image: ghcr.io/mwasilew/docker-mkbootimage:master
        steps:
{% set flash_url = node.artifacts.flash_image %}
{% set flash_path = flash_url.split('?')[0] %}
{% set flash_name = flash_path.split('/')[-1] %}
        - export IMAGE_PATH=$PWD
        - mkdir -p flash_content
        - tar -xf {{ flash_name }} -C flash_content
        - rm {{ flash_name }}
{% if node.artifacts.rootfs_image %}
{% set rootfs_url = node.artifacts.rootfs_image %}
{% set rootfs_path = rootfs_url.split('?')[0] %}
{% set rootfs_name = rootfs_path.split('/')[-1] %}
        - mv {{ rootfs_name }} flash_content/rootfs.img
{% endif %}
        - echo "=== rootfs.img size ==="
        - ls -lh flash_content/rootfs.img
        - |
          MAGIC=$(od -A n -t x1 -N 4 flash_content/rootfs.img | tr -d ' \n')
          echo "=== rootfs.img magic bytes: $MAGIC ==="
          if [ "$MAGIC" = "3aff26ed" ]; then
            echo "=== Detected sparse image, converting to raw ext4 ==="
            simg2img flash_content/rootfs.img flash_content/rootfs_raw.img
            mv flash_content/rootfs_raw.img flash_content/rootfs.img
            echo "=== Conversion done, new size ==="
            ls -lh flash_content/rootfs.img
          else
            echo "=== rootfs.img is already raw ext4, no conversion needed ==="
          fi
        - cp overlay*.tar.gz overlay.tar.gz
        - echo "=== Overlay inspection ==="
        - tar -tzf overlay.tar.gz | head -20
        - echo "=== /etc/passwd in overlay ===" && tar -xOf overlay.tar.gz etc/passwd 2>/dev/null || echo "No etc/passwd found in overlay"
        - echo "=== /etc/shadow in overlay ===" && tar -xOf overlay.tar.gz etc/shadow 2>/dev/null || echo "No etc/shadow found in overlay"
        - echo "=== Baking overlay into rootfs using debugfs ==="
        - mkdir -p /tmp/lava_overlay
        - tar -xzf overlay.tar.gz -C /tmp/lava_overlay
        - |
          python3 -c "
          import os
          base = '/tmp/lava_overlay'
          dir_lines = []
          file_lines = []
          for root, dirs, files in os.walk(base):
              relroot = os.path.relpath(root, base)
              if relroot != '.':
                  depth = relroot.count(os.sep)
                  dir_lines.append((depth, 'mkdir /' + relroot.replace(os.sep, '/')))
              for f in files:
                  src = os.path.join(root, f)
                  dst = relroot + '/' + f if relroot != '.' else f
                  dst = '/' + dst.replace(os.sep, '/')
                  file_lines.append('write ' + src + ' ' + dst)
          dir_lines.sort(key=lambda x: x[0])
          print('\n'.join([l for _, l in dir_lines] + file_lines))
          " > /tmp/debugfs_cmds.txt
        - echo "=== debugfs commands preview (first 20) ==="
        - head -20 /tmp/debugfs_cmds.txt
        - echo "=== Total commands to run ==="
        - wc -l /tmp/debugfs_cmds.txt
        - |
          debugfs -w flash_content/rootfs.img < /tmp/debugfs_cmds.txt 2>&1 | tee /tmp/debugfs_output.txt
          if grep -iE "error|no such|failed|cannot" /tmp/debugfs_output.txt; then
            echo "WARNING: debugfs reported errors above - overlay may be incomplete"
          else
            echo "=== debugfs baking completed without errors ==="
          fi
        - echo "=== Verifying overlay baked into rootfs ==="
        - |
          LAVA_DIR=$(ls /tmp/lava_overlay/ | grep '^lava-' | head -1)
          if [ -n "$LAVA_DIR" ]; then
            echo "Checking /$LAVA_DIR in rootfs..."
            echo "ls /$LAVA_DIR" | debugfs flash_content/rootfs.img 2>&1 | grep -v "^$"
            if echo "ls /$LAVA_DIR" | debugfs flash_content/rootfs.img 2>&1 | grep -q "environment"; then
              echo "SUCCESS: overlay baked correctly - environment file found in /$LAVA_DIR"
            else
              echo "WARNING: environment file NOT found in /$LAVA_DIR - overlay baking may have failed"
            fi
          else
            echo "WARNING: No lava- directory found in overlay at /tmp/lava_overlay"
          fi
        - echo "DEVICE_TYPE={{ platform_config.name }}" >> $IMAGE_PATH/flash.settings
        - echo "PORT=0" >> $IMAGE_PATH/flash.settings
        - cat $IMAGE_PATH/flash.settings
        - tar -cf combined_flash.tar -C flash_content .
        - rm -rf flash_content
    timeout:
      minutes: 120
    to: downloads

- deploy:
    images:
      image:
        url: 'downloads://combined_flash.tar'
      settings:
        url: downloads://flash.settings
    timeout:
      minutes: 10
    to: flasher

- boot:
    auto_login:
      login_prompt: '(.*)login:'
      username: root
      password_prompt: Password
      password: oelinux123
    prompts:
    - root@(.*):[/~]#
    failure_retry: 3
    timeout:
      minutes: 20
    timeouts:
      bootloader-commands:
        minutes: 5
      auto-login-action:
        minutes: 20
    method: minimal
